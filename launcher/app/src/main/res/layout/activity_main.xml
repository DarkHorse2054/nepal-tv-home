<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#03060B">
    <com.gathin.tvhome.NepalBackdrop android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="56dp" android:paddingEnd="56dp" android:paddingTop="24dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="40dp">
            <LinearLayout android:id="@+id/nepalIdentity" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_alignParentStart="true" android:layout_toStartOf="@+id/topButtons"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/omSymbol" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ॐ" android:contentDescription="Om" android:textColor="#AA9170" android:textSize="19sp" android:fontFamily="@font/nepali" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/nepalDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#CAD5E3" android:textSize="12sp" android:singleLine="true" android:fontFamily="@font/outfit_modern" />
                    <TextView android:id="@+id/kathmanduClock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:textColor="#8D9DB0" android:textSize="10sp" android:singleLine="true" android:fontFamily="@font/outfit_modern" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/topButtons" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_alignParentEnd="true" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/btnTools" style="@style/TopButton" android:contentDescription="@string/tools" android:drawableStart="@drawable/ic_tools" android:nextFocusRight="@+id/btnSources" android:nextFocusDown="@+id/grid" />
                <TextView android:id="@+id/btnSources" style="@style/TopButton" android:contentDescription="@string/sources" android:drawableStart="@drawable/ic_sources" android:nextFocusLeft="@+id/btnTools" android:nextFocusRight="@+id/btnWifi" android:nextFocusDown="@+id/grid" />
                <TextView android:id="@+id/btnWifi" style="@style/TopButton" android:contentDescription="@string/wifi" android:drawableStart="@drawable/ic_wifi" android:nextFocusLeft="@+id/btnSources" android:nextFocusRight="@+id/btnSettings" android:nextFocusDown="@+id/grid" />
                <TextView android:id="@+id/btnSettings" style="@style/TopButton" android:contentDescription="@string/settings" android:drawableStart="@drawable/ic_settings" android:nextFocusLeft="@+id/btnWifi" android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="42dp"
            android:orientation="vertical">
            <TextView android:id="@+id/localLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SAN MATEO" android:textColor="#B3C2D3" android:textSize="10sp" android:letterSpacing="0.14" android:fontFamily="@font/outfit_modern" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="6dp">
                <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#F4F7FA" android:textSize="92sp" android:fontFamily="@font/outfit_modern" android:includeFontPadding="false" android:letterSpacing="-0.055" />
                <TextView android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                    android:layout_gravity="bottom" android:layout_marginBottom="12dp" android:textColor="#738397" android:textSize="16sp" android:fontFamily="@font/outfit_modern" />
            </LinearLayout>
            <TextView android:id="@+id/localDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="#CAD5E3" android:textSize="14sp" android:fontFamily="@font/outfit_modern" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="456dp" android:layout_gravity="center_horizontal" android:layout_height="match_parent"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="12dp" android:clipToPadding="false" android:clipChildren="false"
                android:overScrollMode="never" android:scrollbars="none" android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>
    <com.gathin.tvhome.GlassView android:id="@+id/glass" android:layout_width="10dp" android:layout_height="10dp" android:alpha="0" android:importantForAccessibility="no" />
</FrameLayout>
