<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Native catalogue and the provider's documented embedded player. -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_framextv"
        android:banner="@drawable/framextv_banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.FrameXtv">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".EmbedPlayerActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
